# SmolOfis control panel — first interactive surface of the appliance.
#
# Ordered only after network.target so the "Initializing system..." page is
# reachable within seconds of the kernel handing over to systemd, long before
# Docker or the application containers exist. Traefik routes port 80 here once
# it is running.

[Unit]
Description=SmolOfis Control Panel (Rust dashboard on port 8090)
Documentation=https://github.com/jcyrus/smolofis
After=network.target
Wants=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/smolofis-panel
Restart=always
RestartSec=2

User=smolofis-panel
Group=smolofis-panel
# Read-only access to the engine socket for the /_ping health probe.
SupplementaryGroups=docker

Environment=SMOLOFIS_BIND=0.0.0.0:8090
Environment=SMOLOFIS_GITEA_URL=http://127.0.0.1:3000
Environment=SMOLOFIS_COOLIFY_URL=http://127.0.0.1:8000
Environment=SMOLOFIS_DATA_PATH=/var/lib/smolofis
Environment=RUST_LOG=info

CapabilityBoundingSet=

# Hardening: the panel only reads telemetry and talks to local sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: getifaddrs needs it to read the Tailscale address.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
