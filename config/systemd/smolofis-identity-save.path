# Captures operator password changes as soon as passwd rewrites /etc/shadow,
# so they survive a reboot or a power cut.

[Unit]
Description=Watch /etc/shadow for operator password changes
# No ordering against smolofis-identity.service: that runs after basic.target,
# which waits for path units, so the loop makes systemd drop a job at boot.

[Path]
PathChanged=/etc/shadow

[Install]
WantedBy=multi-user.target
