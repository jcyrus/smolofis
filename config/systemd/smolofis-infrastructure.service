# SmolOfis application stack — Gitea + Coolify under docker compose.
#
# Strictly ordered after the Docker engine and the network being online;
# first boot can take several minutes while images are pulled, hence the
# generous start timeout. State persists under /var/lib/smolofis/.

[Unit]
Description=SmolOfis Docker application stack (Gitea + Coolify)
Documentation=https://github.com/jcyrus/smolofis
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Without a data partition Docker would sit on the RAM overlay, where it cannot
# run: the panel reports live mode and asks the operator to install instead.
ConditionPathIsMountPoint=/var/lib/smolofis

[Service]
Type=oneshot
RemainAfterExit=yes
# Compose picks up docker-compose.yml from the image, plus an operator's
# docker-compose.override.yml when one exists.
WorkingDirectory=/etc/smolofis

# Generates per-device secrets and persistent storage tracks (idempotent).
ExecStartPre=/usr/local/bin/smolofis-firstboot

# Traefik first, so ports 80 and 443 answer while the stack comes up. Failure
# here must not stop the stack; the panel stays reachable on port 8090.
ExecStart=-/usr/bin/docker compose --project-name coolify-proxy --file /data/coolify/proxy/docker-compose.yml up --detach
ExecStart=/usr/bin/docker compose --project-name smolofis up --detach --remove-orphans
ExecStop=/usr/bin/docker compose --project-name smolofis stop

# First boot pulls ~2 GB of images on slow office links.
TimeoutStartSec=1800
TimeoutStopSec=120

StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
