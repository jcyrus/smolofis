#!/bin/sh
# init-bottom runs after live-boot has mounted persistence, before systemd.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac
set -eu
if [ -f /scripts/functions ]; then
    . /scripts/functions
fi
fatal() {
    echo "smolofis-machine-id: $*" >&2
    if command -v panic >/dev/null 2>&1; then panic "smolofis-machine-id: $*"; fi
    exit 1
}
rootmnt="${rootmnt:-/root}"
case "$rootmnt" in /*) ;; *) fatal 'absolute root mount required' ;; esac
base="$rootmnt/etc/smolofis"
# Do not initialize a durable identity on a nonpersistent Live USB root.
mounted=0
while read -r _device target _rest; do
    if [ "$target" = "$base" ]; then mounted=1; break; fi
done < /proc/mounts
[ "$mounted" -eq 1 ] || exit 0
trusted_directory() {
    current="$1"
    while :; do
        [ -d "$current" ] && [ ! -L "$current" ] || fatal 'unsafe identity directory'
        [ "$(stat -c %u "$current")" = 0 ] || fatal 'identity directory must be root-owned'
        mode="$(stat -c %a "$current")"
        [ $((0$mode & 022)) -eq 0 ] || fatal 'identity directory is publicly writable'
        [ "$current" != / ] || break
        current="${current%/*}"
        [ -n "$current" ] || current=/
    done
}
trusted_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || fatal 'unsafe machine-id file'
    [ "$(stat -c %u:%h "$1")" = 0:1 ] || fatal 'machine-id must be root-owned with one link'
    mode="$(stat -c %a "$1")"
    [ $((0$mode & 022)) -eq 0 ] || fatal 'machine-id is publicly writable'
}
valid_id() {
    [ "${#1}" -eq 32 ] || return 1
    case "$1" in *[!0-9a-f]*|00000000000000000000000000000000) return 1 ;; esac
}
trusted_directory "$base"
identity="$base/identity"
if [ ! -e "$identity" ] && [ ! -L "$identity" ]; then mkdir -m 0700 "$identity"; fi
trusted_directory "$identity"
saved="$identity/machine-id"
if [ -e "$saved" ] || [ -L "$saved" ]; then
    trusted_file "$saved"
    [ "$(stat -c %s "$saved")" -le 33 ] || fatal 'oversized saved machine-id'
    id="$(cat "$saved")"
    valid_id "$id" || fatal 'invalid saved machine-id; local recovery required'
else
    IFS= read -r uuid < /proc/sys/kernel/random/uuid
    id="$(printf '%s' "$uuid" | tr -d '-')"
    valid_id "$id" || fatal 'machine-id entropy unavailable'
    temporary="$(mktemp "$identity/.machine-id.XXXXXX")"
    printf '%s\n' "$id" > "$temporary"
    sync
    mv "$temporary" "$saved"
    sync
fi
# The image supplies a regular empty file. Never follow a substituted link.
trusted_file "$rootmnt/etc/machine-id"
printf '%s\n' "$id" > "$rootmnt/etc/machine-id"
chmod 0644 "$rootmnt/etc/machine-id"
