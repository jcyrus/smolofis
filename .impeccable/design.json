  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Console action; primary or secondary emphasis.",
      "html": "<button class=\"ds-primary\">View service health</button>",
      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:0;border-radius:9px;font-size:13px;font-weight:550;line-height:1.4;background:var(--green);color:var(--surface);cursor:pointer;transition:background 160ms var(--ease),color 160ms var(--ease)}.ds-primary:hover{background:var(--green-hover)}.ds-primary:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Console action; primary or secondary emphasis.",
      "html": "<button class=\"ds-secondary\">View service health</button>",
      "css": ".ds-secondary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:0;border-radius:9px;font-size:13px;font-weight:550;line-height:1.4;background:var(--surface-soft);color:var(--ink);cursor:pointer;transition:background 160ms var(--ease),color 160ms var(--ease)}.ds-secondary:hover{background:var(--line)}.ds-secondary:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current page in desktop navigation.",
      "html": "<nav aria-label=\"Console\"><a class=\"ds-nav\" href=\"#\" aria-current=\"page\">Overview</a></nav>",
      "css": ".ds-nav{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:flex;align-items:center;min-height:46px;padding:10px 13px;border-radius:10px;background:var(--green-soft);color:var(--green);font-size:14px;font-weight:600;text-decoration:none;transition:background 160ms var(--ease),color 160ms var(--ease)}.ds-nav:hover{color:var(--ink);background:var(--surface-soft)}.ds-nav:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Task card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "Text portion of the destination tile; production adds an outlined SVG icon and arrow.",
      "html": "<a class=\"ds-task\" href=\"#\"><strong>Service health</strong><p>Spot a problem and understand its impact.</p><span>3 of 3 online</span></a>",
      "css": ".ds-task{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:block;max-width:260px;padding:22px 20px 20px;border-radius:16px;background:var(--surface);color:var(--ink);text-decoration:none;transition:background 160ms var(--ease),transform 160ms var(--ease)}.ds-task strong{font-size:15px;font-weight:600}.ds-task p{margin:6px 0 0;color:var(--muted);font-size:13px;line-height:1.6}.ds-task span{display:block;margin-top:19px;font-size:12px;color:var(--muted)}.ds-task:hover{transform:translateY(-2px);background:var(--surface-soft)}.ds-task:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }@media(prefers-reduced-motion:reduce){.ds-task{transition:none}.ds-task:hover{transform:none}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Diagnostics fallback",
      "kind": "input",
      "refersTo": "diagnostics-field",
      "description": "Read-only fallback for manual copying; not an editable administration field.",
      "html": "<textarea class=\"ds-field\" readonly aria-label=\"Service diagnostics to copy\">Latest check: online</textarea>",
      "css": ".ds-field{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;resize:vertical;width:100%;min-height:145px;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font-size:13px}.ds-field:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
