      "html": "<span class=\"ds-status\">Online</span>",
      "css": ".ds-status{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:550;color:var(--green)}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
